#!/bin/sh
# Whimsical repos for the Raster preview: some with logos, branches ahead or behind.
set -e
P=$1; mkdir -p "$P" "$P/.remotes"
repo() { # name [logo-svg]
  r="$P/$1"; rm -rf "$r" "$P/.remotes/$1.git"
  git init -q -b main "$r"; git -C "$r" config user.name Demo; git -C "$r" config user.email demo@example.invalid
  echo "# $1" > "$r/README.md"
  [ -n "$2" ] && printf '%s' "$2" > "$r/icon.svg"
  git -C "$r" add -A; git -C "$r" commit -qm start
  git init -q --bare -b main "$P/.remotes/$1.git"
  git -C "$r" remote add origin "$P/.remotes/$1.git"; git -C "$r" push -q -u origin main
}
ahead() { echo "$3" >> "$P/$1/README.md"; git -C "$P/$1" checkout -q -B "$2"; git -C "$P/$1" commit -qam "$3"; git -C "$P/$1" push -q -u origin "$2"; echo more >> "$P/$1/README.md"; git -C "$P/$1" commit -qam more; }
behind() { echo x >> "$P/$1/README.md"; git -C "$P/$1" commit -qam x; git -C "$P/$1" push -q; git -C "$P/$1" reset -q --hard HEAD~1; }

